<?xml version="1.0" encoding="UTF-8"?>
<!--
  sureai SpotBugs 排除清单：
  仅排除「设计意图 / 惯例性」告警，真实缺陷一律修复而非排除。
  新增排除项必须在注释中说明理由。
-->
<FindBugsFilter>

    <!-- 构造器参数校验抛异常（CT_CONSTRUCTOR_THROW）：
         sureai 工具类均为 final 不可继承、无 finalize 方法，不存在 Finalizer 攻击面。 -->
    <Match>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>

    <!-- Boolean 包装类型显式返回 null（NP_BOOLEAN_RETURN_NULL）：
         JSON 模型 getBool 语义刻意设计——缺失值返回 null（区别于 false）。 -->
    <Match>
        <Bug pattern="NP_BOOLEAN_RETURN_NULL"/>
    </Match>

    <!-- 内部可变集合直接暴露（EI_EXPOSE_REP / EI_EXPOSE_REP2）：
         JsonObject/JsonArray 为自研可变 JSON 模型，设计上即允许调用方读写，
         与 org.json 等主流实现行为一致。 -->
    <Match>
        <Class name="com.sure.ai.internal.json.JsonObject"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="com.sure.ai.internal.json.JsonArray"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!-- Builder 模式暂存外部集合引用（EI_EXPOSE_REP2）：
         ChatRequest.Builder 仅在 build() 时 List.copyOf 防御性拷贝，
         产物不可变；Builder 本身是一次性可变装配器，暂存引用是惯例。 -->
    <Match>
        <Class name="~com.sure.ai.model.ChatRequest\$Builder"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!-- 流式分片返回增量 toolCalls（EI_EXPOSE_REP / EI_EXPOSE_REP2）：
         ChatStreamChunk 为不可变记录，构造时已 List.copyOf；
         返回不可变 List 供消费者读取，设计意图即只读访问。 -->
    <Match>
        <Class name="com.sure.ai.model.ChatStreamChunk"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!-- 内部结果记录暴露可变 JsonObject（EI_EXPOSE_REP）：
         PostResult 为 protected 内部传递载体，JsonObject 本身即只读解析视图。 -->
    <Match>
        <Class name="~com.sure.ai.client.AbstractAiClient\$PostResult"/>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>

    <!-- 持锁 sleep（SWL_SLEEP_WITH_LOCK_HELD）：
         百度 access_token 缓存刷新等待时持 synchronized 锁是有意设计，
         保证多线程并发下只刷新一次。 -->
    <Match>
        <Bug pattern="SWL_SLEEP_WITH_LOCK_HELD"/>
    </Match>

    <!-- Builder 模式暂存外部组件引用（EI_EXPOSE_REP2）：
         RagPipeline.Builder 为一次性装配器，vectorStore/splitter/retriever
         本就是调用方提供的共享组件（VectorStore 等为有状态服务），
         语义即按引用共享，与 ChatRequest.Builder 同类惯例。 -->
    <Match>
        <Class name="~com.sure.ai.rag.pipeline.RagPipeline\$Builder"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!-- STT 段级记录暴露不可变词级列表（EI_EXPOSE_REP / EI_EXPOSE_REP2）：
         Segment 为不可变 record，规范构造器已 List.copyOf 防御性拷贝，
         words() 返回不可变 List 供消费者只读访问，与 ChatStreamChunk 同类惯例。 -->
    <Match>
        <Class name="com.sure.ai.model.Segment"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!-- Builder 模式暂存外部字节数组引用（EI_EXPOSE_REP2）：
         SttRequest.Builder.audioData 已在 setter 中 clone 防御性拷贝，
         产物不可变；Builder 本身是一次性可变装配器，与 ChatRequest.Builder 同类惯例。 -->
    <Match>
        <Class name="~com.sure.ai.model.SttRequest\$Builder"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!-- Builder 模式暂存外部候选文档列表引用（EI_EXPOSE_REP2）：
         RerankRequest.Builder.documents 仅在 build() 时 List.copyOf 防御性拷贝，
         产物不可变；Builder 本身是一次性可变装配器，与 ChatRequest.Builder 同类惯例。 -->
    <Match>
        <Class name="~com.sure.ai.model.RerankRequest\$Builder"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!-- Builder 模式暂存外部对话请求列表引用（EI_EXPOSE_REP2）：
         BatchRequest.Builder.requests 仅在 build() 时 List.copyOf 防御性拷贝，
         产物不可变；Builder 本身是一次性可变装配器，与 ChatRequest.Builder 同类惯例。 -->
    <Match>
        <Class name="~com.sure.ai.model.BatchRequest\$Builder"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!-- Builder 模式暂存外部向量存储/向量化组件引用（EI_EXPOSE_REP2）：
         VectorRetriever.Builder 为一次性装配器，store/embeddingProvider 本就是调用方
         提供的共享有状态组件，语义即按引用共享，与 RagPipeline.Builder 同类惯例。 -->
    <Match>
        <Class name="~com.sure.ai.rag.retriever.VectorRetriever\$Builder"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!-- Realtime 客户端单例字段未被 SpotBugs 识别（UUF_UNUSED_FIELD）：
         QwenUtil.realtimeClient 为 volatile 字段，采用双检锁（double-checked locking）
         懒加载并在 resetRealtimeClient() 中置空；SpotBugs 对该并发惯用法存在已知误报，
         字段实际既被读（本地缓存命中）也被写（初始化与重置）。 -->
    <Match>
        <Class name="com.sure.ai.qwen.QwenUtil"/>
        <Bug pattern="UUF_UNUSED_FIELD"/>
    </Match>

    <!-- AgentUtil 全局注册中心单例字段未被 SpotBugs 识别（UUF_UNUSED_FIELD）：
         AgentUtil.globalRegistry 为 volatile 字段，采用双检锁懒加载，
         并在 resetRegistry() 中重新赋值；与 QwenUtil.realtimeClient 同类并发惯用法，
         SpotBugs 对该模式存在已知误报，字段实际既被读（registry() 命中）也被写。 -->
    <Match>
        <Class name="com.sure.ai.agent.AgentUtil"/>
        <Bug pattern="UUF_UNUSED_FIELD"/>
    </Match>

    <!-- PlanExecuteAgent 骨架类构造参数字段暂未使用（UUF_UNUSED_FIELD）：
         该类为 Plan-and-Execute 编排器的占位骨架，构造器签名已与 ReActAgent 对齐
         以便后续无缝替换；run() 当前抛 UnsupportedOperationException，
         保存的 client/baseRequest/registry/listener/maxIterations/timeout 字段是
         为下一阶段完整实现预留的入参，并非死代码，故排除而非删除。 -->
    <Match>
        <Class name="com.sure.ai.agent.plan.PlanExecuteAgent"/>
        <Bug pattern="UUF_UNUSED_FIELD"/>
    </Match>

    <!-- AgentUtil.registry() 返回全局可变注册中心（MS_EXPOSE_REP）：
         全局 ToolRegistry 设计上就是供调用方 register/unregister 的可变共享单例，
         与 QwenUtil.realtimeClient 同类语义；返回可变引用是 API 本意（便捷入口），
         复杂场景建议直接 new ToolRegistry()，见类 JavaDoc。 -->
    <Match>
        <Class name="com.sure.ai.agent.AgentUtil"/>
        <Bug pattern="MS_EXPOSE_REP"/>
    </Match>

    <!-- 编排器持有外部共享 ToolRegistry 引用（EI_EXPOSE_REP2）：
         ReActAgent / PlanExecuteAgent 的 registry 本就是调用方传入的有状态共享组件，
         语义即按引用共享（调用方在编排期仍可动态注册/注销工具，编排器每轮实时读取
         getToolSpecs/getHandler），与 RagPipeline.Builder 暂存共享组件同类惯例。 -->
    <Match>
        <Class name="com.sure.ai.agent.react.ReActAgent"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="com.sure.ai.agent.plan.PlanExecuteAgent"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!-- 不可变快照记录暴露集合/数组引用（EI_EXPOSE_REP / EI_EXPOSE_REP2）：
         AiMetrics.Snapshot 由 snapshot() 构造时已对 statusCodeCounts 做 Map.copyOf、
         对 durationHistogram 做新数组拷贝，运行时不可变；SpotBugs 无法识别 record
         构造期的防御性拷贝，与 ChatStreamChunk/PostResult 同类只读视图惯例。 -->
    <Match>
        <Class name="~com.sure.ai.client.observability.AiMetrics\$Snapshot"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!-- Micrometer 适配器持有外部 MeterRegistry 引用（EI_EXPOSE_REP2）：
         MeterRegistry 是调用方注入的共享注册表（如 SimpleMeterRegistry / Prometheus 实例），
         本适配器只向其写入指标、不持有所有权，与 RagPipeline.Builder 暂存共享组件同类惯例；
         调用方负责 Registry 的生命周期与跨指标共享。 -->
    <Match>
        <Class name="com.sure.ai.micrometer.MicrometerMetricsAdapter"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

</FindBugsFilter>
