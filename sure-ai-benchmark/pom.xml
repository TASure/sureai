<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.tasure</groupId>
        <artifactId>sureai</artifactId>
        <version>1.2.0-SNAPSHOT</version>
    </parent>

    <artifactId>sure-ai-benchmark</artifactId>
    <packaging>jar</packaging>
    <name>sureai-benchmark</name>
    <description>JMH 性能基准模块：对 core 的 JSON 序列化/反序列化、ChatRequest 构建、
        OpenAI 兼容协议请求体序列化、SSE 行解析等热点路径做微基准。
        红线：jmh-core / jmh-generator-annprocess 仅 test scope，不进 sure-ai-all、不进运行期依赖链；
        本模块不依赖任何平台模块，仅依赖 sure-ai-core；默认 mvn verify 不执行 benchmark。</description>

    <properties>
        <!-- JMH 稳定版（仅本模块内部使用，不上提父 POM dependencyManagement） -->
        <jmh.version>1.37</jmh.version>
        <!-- 基准代码不参与覆盖率统计（参考 sure-ai-spring-boot-starter 惯例） -->
        <jacoco.skip>true</jacoco.skip>
        <!-- 基准代码为性能探针，跳过 SpotBugs 深度扫描 -->
        <spotbugs.skip>true</spotbugs.skip>
    </properties>

    <dependencies>
        <!-- 唯一编译期依赖：core（不依赖任何平台模块） -->
        <dependency>
            <groupId>io.github.tasure</groupId>
            <artifactId>sure-ai-core</artifactId>
        </dependency>

        <!-- JMH 仅 test scope：不传递给下游、不进运行期依赖链 -->
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-core</artifactId>
            <version>${jmh.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- JMH 注解处理器：test scope，同时通过 annotationProcessorPaths 参与编译 -->
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-generator-annprocess</artifactId>
            <version>${jmh.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 显式声明 annotationProcessorPaths，确保 test 编译期生成 JMH 合成代码 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.openjdk.jmh</groupId>
                            <artifactId>jmh-generator-annprocess</artifactId>
                            <version>${jmh.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <!-- 默认 skipTests：mvn verify 不执行 benchmark（编译/检查仍通过） -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <skipTests>true</skipTests>
                </configuration>
            </plugin>
            <!-- 便捷运行：mvn -pl sure-ai-benchmark exec:java
                 等价于 java org.openjdk.jmh.Main，参数透传（如 -wi 3 -i 5）。 -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.2.0</version>
                <executions>
                    <execution>
                        <id>jmh-main</id>
                        <phase>none</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <mainClass>org.openjdk.jmh.Main</mainClass>
                    <classpathScope>test</classpathScope>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
