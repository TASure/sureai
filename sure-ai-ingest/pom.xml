<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.tasure</groupId>
        <artifactId>sureai</artifactId>
        <version>2.6.0-SNAPSHOT</version>
    </parent>

    <artifactId>sure-ai-ingest</artifactId>
    <packaging>jar</packaging>
    <name>sureai-ingest</name>
    <description>文档导入器：把本地文件 / URL 加载为带元数据的 RAG 文档。复用 sure-ai-rag 的 Document 模型与
        TextSplitter 分块链路，保持 RagPipeline 兼容。纯文本族（TXT/MD/HTML）与 PDF 文本层提取均为纯 JDK 实现、
        零第三方运行期依赖；DOCX/XLSX/PPTX 由可选模块 sure-ai-ingest-poi（Apache POI provided）提供。</description>

    <dependencies>
        <!-- 复用 rag 的 Document 模型、TextSplitter 与加载链路；rag 仅依赖 core -->
        <dependency>
            <groupId>io.github.tasure</groupId>
            <artifactId>sure-ai-rag</artifactId>
        </dependency>
    </dependencies>
</project>
