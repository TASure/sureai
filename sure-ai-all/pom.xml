<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.tasure</groupId>
        <artifactId>sureai</artifactId>
        <version>2.6.0-SNAPSHOT</version>
    </parent>

    <artifactId>sure-ai-all</artifactId>
    <packaging>pom</packaging>
    <name>sureai-all</name>
    <description>聚合模块：一个依赖引入全部平台模块。</description>

    <properties>
        <jacoco.skip>true</jacoco.skip>
        <spotbugs.skip>true</spotbugs.skip>
    </properties>

    <build>
        <plugins>
            <!-- CycloneDX SBOM：在 package 阶段基于本模块完整依赖树生成聚合 BOM。
                 sure-ai-all 依赖全部平台模块（io.github.tasure:*），其依赖树即完整 SBOM；
                 跳过 test 作用域依赖（junit）。产物：target/bom.xml + target/bom.json。
                 插件版本由父 pom <pluginManagement> 统一管理，仅 build 期执行。 -->
            <plugin>
                <groupId>org.cyclonedx</groupId>
                <artifactId>cyclonedx-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>make-aggregate-sbom</id>
                        <phase>package</phase>
                        <goals>
                            <goal>makeBom</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <projectType>library</projectType>
                    <outputFormat>all</outputFormat>
                    <outputName>bom</outputName>
                    <includeTestScope>false</includeTestScope>
                </configuration>
            </plugin>
        </plugins>
    </build>

