<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.tasure</groupId>
        <artifactId>sureai</artifactId>
        <version>2.6.0-SNAPSHOT</version>
    </parent>

    <artifactId>sure-ai-ingest-poi</artifactId>
    <packaging>jar</packaging>
    <name>sureai-ingest-poi</name>
    <description>可选文档导入扩展：基于 Apache POI 解析 DOCX/XLSX/PPTX 为 RAG 文档。
        Apache POI 以 provided 引入，不向使用者传递、不进 sure-ai-all 运行期聚合链；
        使用方需自行在工程中显式声明 org.apache.poi:poi-ooxml 依赖。</description>

    <dependencies>
        <dependency>
            <groupId>io.github.tasure</groupId>
            <artifactId>sure-ai-ingest</artifactId>
        </dependency>
        <!-- Apache POI 仅 provided：不传递给下游，保持主库运行期零第三方依赖特性。
             测试期 provided 依赖在 test classpath 可见，可直接构造内存文档解析。 -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>
