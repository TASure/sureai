<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.tasure</groupId>
        <artifactId>sureai</artifactId>
        <version>2.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>sure-ai-otel</artifactId>
    <packaging>jar</packaging>
    <name>sureai-otel</name>
    <description>sureai 可观测性 OpenTelemetry 桥接：把 MetricsCollector / RetryListener / AgentEvent
        映射为 OpenTelemetry GenAI 语义约定（gen_ai.*）指标与 span 事件，可直接进 Langfuse/Jaeger/Tempo。
        opentelemetry-api 与 opentelemetry-context 以 provided 引入，不向使用者传递——SDK 由使用方在
        runtime 自行提供；未接入 OTel 时全链路空操作，行为与未接入一致。本模块不进入 sure-ai-all 聚合。</description>

    <properties>
        <!-- OpenTelemetry Java 核心版本（2026-09 最新稳定版）。仅 provided / test，不进运行期依赖链 -->
        <otel.version>1.66.0</otel.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.tasure</groupId>
            <artifactId>sure-ai-core</artifactId>
        </dependency>
        <!-- AgentEvent 桥接需要 agent 事件类型（agent 仅依赖 core，零第三方依赖） -->
        <dependency>
            <groupId>io.github.tasure</groupId>
            <artifactId>sure-ai-agent</artifactId>
        </dependency>

        <!-- OpenTelemetry API 仅 provided：不传递给下游，避免破坏 core 零依赖特性。
             runtime 的 OTel SDK（opentelemetry-sdk + 导出器）由使用方自行引入。 -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-api</artifactId>
            <version>${otel.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-context</artifactId>
            <version>${otel.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- 测试用：内存 MeterReader / SpanExporter，零真实网络，仅 test scope -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-sdk</artifactId>
            <version>${otel.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-sdk-testing</artifactId>
            <version>${otel.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
