<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.tasure</groupId>
        <artifactId>sureai</artifactId>
        <version>2.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>sure-ai-cli</artifactId>
    <packaging>jar</packaging>

    <name>sureai-cli</name>
    <description>命令行直接问答工具：chat / stream / rag / list / repl 子命令，一键切换全部 23 个平台。
        应用层模块，可打 fat jar 并支持 GraalVM native-image；不进入 sure-ai-all 聚合链。</description>

    <dependencies>
        <!-- sure-ai-all（pom 聚合）传递引入 core/rag/agent/mcp 及全部平台模块，CLI 应用层直接复用 -->
        <dependency>
            <groupId>io.github.tasure</groupId>
            <artifactId>sure-ai-all</artifactId>
            <version>${project.version}</version>
            <type>pom</type>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 打 fat jar：合并全部依赖，保留 META-INF/native-image 下各平台 AOT 元数据 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>build-fat-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.sure.ai.cli.Main</mainClass>
                                </transformer>
                                <!-- 合并 META-INF/services，native-image 目录按路径共存、不被裁剪 -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
