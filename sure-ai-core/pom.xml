        <jacoco.line.min>0.70</jacoco.line.min>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.tasure</groupId>
            <artifactId>sure-core</artifactId>
        </dependency>
    </dependencies>
</project>
