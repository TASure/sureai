<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.tasure</groupId>
        <artifactId>sureai</artifactId>
        <version>3.0.0</version>
    </parent>

    <artifactId>sure-ai-templates</artifactId>
    <packaging>jar</packaging>

    <name>sureai-templates</name>
    <description>模板应用库（v3.0.0）：知识库问答 / 客服机器人 / 代码助手三类可运行模板，
        经 TemplateGenerator 一键生成独立工程（pom + 主类 + 最小单测 + README，可直接 mvn test / mvn exec:java）。
        模板资源内嵌 classpath，生成器零第三方依赖（手写占位符替换，不引 freemarker/snakeyaml）。
        工具/应用层模块，不进入 sure-ai-all 聚合链与 BOM（与 sure-ai-cli / sure-ai-archetype 同例）。</description>

    <!-- 本模块零编译期依赖（纯 JDK 实现生成器）；junit 由父工程统一注入 -->

    <!-- 资源过滤：仅对 sureai-version.properties 注入 @project.version@（模板目录 {{...}} 占位符不受 Maven filtering 影响） -->
    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>sureai-version.properties</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>sureai-version.properties</exclude>
                </excludes>
            </resource>
        </resources>
    </build>
</project>
