<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.tasure</groupId>
        <artifactId>sureai</artifactId>
        <version>2.5.0</version>
    </parent>

    <artifactId>sure-ai-framework</artifactId>
    <packaging>jar</packaging>
    <name>sureai-framework</name>
    <description>声明式编排层：接口即服务（AiService）。基于 JDK 动态代理把带 @SystemMessage/@UserMessage/@Tool/@Memory 注解的 Java 接口映射为可调用的 AI 服务，一行 FrameworkUtil.create 即得代理；复用 core 的 AiClient、JsonSchemaGenerator 与结构化输出能力，零第三方运行期依赖。</description>

    <dependencies>
        <dependency>
            <groupId>io.github.tasure</groupId>
            <artifactId>sure-ai-core</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 保留方法参数名（Method#getName），供 {paramName} 模板占位符按名匹配。
                 仅作用于本模块编译产物；下游若未开启 -parameters，可改用 @Param 显式绑定。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <parameters>true</parameters>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
