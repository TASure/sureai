<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.tasure</groupId>
        <artifactId>sureai</artifactId>
        <version>2.9.0</version>
    </parent>
    <artifactId>sure-ai-ollama</artifactId>
    <packaging>jar</packaging>
    <name>sureai-ollama</name>
    <description>Ollama 本地推理服务非 OpenAI 兼容协议模块：无鉴权、NDJSON 流式逐行解析、/api/chat 与 /api/embed 端点映射。</description>
    <properties>
        <!-- JDK25 基线后，HttpClient 在协议层拦截 Content-Length 不符/短报文响应，
             使 OllamaClient.stream 中两个错误体读取 catch 分支（rawBody 回退、NDJSON
             中途断流）在本模块真实网络下不可达（JDK21 可达），行覆盖率 0.97 为
             JDK25 实测上限；对应边界测试 testStreamNon2xxErrorBodyReadFails /
             testStreamTruncatedRead 已存在并验证协议层异常包装路径。 -->
        <jacoco.line.min>0.97</jacoco.line.min>
    </properties>
    <dependencies>
        <dependency>
            <groupId>io.github.tasure</groupId>
            <artifactId>sure-ai-core</artifactId>
        </dependency>
    </dependencies>
</project>
